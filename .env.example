# ─── Site URL ────────────────────────────────────────────────────────────────
# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://zeeonix.com

# ─── Supabase (Phase 4 — Database) ──────────────────────────────────────────
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Email / Notifications (Phase 7) ────────────────────────────────────────
# Resend (https://resend.com) — free tier: 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL=your-email@zeeonix.com
FROM_EMAIL=noreply@zeeonix.com

# ─── AI Provider (Phase 6) ───────────────────────────────────────────────────
# Anthropic Claude API — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ─── Admin Auth (Phase 4 & 5) ────────────────────────────────────────────────
# A strong random secret — generate with: openssl rand -base64 32
JWT_SECRET=your-very-strong-jwt-secret-minimum-32-characters

# ─── Admin Credentials (Phase 5) ─────────────────────────────────────────────
# Initial admin — change immediately after first login
ADMIN_EMAIL=admin@zeeonix.com
ADMIN_PASSWORD=ChangeThisStrongPassword!

# ─── n8n Automation (Phase 7 — optional) ────────────────────────────────────
# Only needed if self-hosting n8n for workflow automation
N8N_WEBHOOK_SECRET=your-n8n-webhook-secret

# ─── WhatsApp Business (Phase 8 — future) ───────────────────────────────────
# Requires Meta Business verification and approved WhatsApp Business API account
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=

# NOTE: Never commit actual values. Copy this file to .env.local and fill in real values.
# .env.local is in .gitignore and will not be pushed to GitHub.
